@page "/"
@using System.Text.Json
@using ErCvApi.Services
@using static ErCvApi.Services.CVGeneratorService
@implements IAsyncDisposable
@inject CVGeneratorService CvService
@inject BrowserStore Store
@inject IJSRuntime JS
@inject ILogger<Home> Logger

<PageTitle>CV Generator - Tailored Professional Resumes</PageTitle>

@if (_view == "generate")
{
    <div class="container app-shell py-4 py-lg-5">
        <Hero />
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="card main-card">
                    <div class="card-body form-card-body">
                        @if (!string.IsNullOrEmpty(_error))
                        {
                            <div class="alert alert-danger alert-dismissible" role="alert">
                                @_error
                                <button type="button" class="btn-close" aria-label="Close" @onclick="() => _error = string.Empty"></button>
                            </div>
                        }
                        @if (_showHistory)
                        {
                            <HistoryPanel Entries="_history"
                                          OnLoad="LoadHistoryEntry"
                                          OnDelete="DeleteHistoryEntry"
                                          OnClear="ClearHistory"
                                          OnClose="() => _showHistory = false"
                                          Disabled="_loading" />
                        }
                        <form class="generator-form" @onsubmit:preventDefault>
                            <div class="form-title-row">
                                <h5 class="form-title mb-0">Generate Your CV</h5>
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm history-toggle-btn"
                                        disabled="@_loading"
                                        @onclick="() => _showHistory = !_showHistory">
                                    @(_showHistory ? "Hide History" : "History")
                                </button>
                            </div>
                            <ComposerSteps Current="_step" OnGoTo="GoToStepAsync" Disabled="_loading" />
                            @if (_step == 1)
                            {
                                <div class="form-section form-section-primary">
                                    <SampleJobPicker Current="@_jobDescription"
                                                     OnSelect="s => _jobDescription = s"
                                                     Disabled="_loading" />
                                    <JobDescriptionInput @bind-Value="_jobDescription"
                                                         Disabled="_loading"
                                                         HelperText="Shortcuts: Ctrl/Cmd+Shift+V paste, Ctrl/Cmd+Enter generate" />
                                </div>
                            }
                            else if (_step == 2)
                            {
                                <div class="form-section form-section-primary">
                                    <ProfileSelector Profiles="_profiles"
                                                     @bind-Value="_profileId"
                                                     Disabled="_loading" />
                                    <TemplateSelector Value="@_settings.Template"
                                                      ValueChanged="SetTemplate"
                                                      Disabled="_loading" />
                                </div>
                            }
                            else
                            {
                                <div class="form-section form-section-primary">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <FormatSelector Selected="_settings.SelectedFormats"
                                                            OnToggle="ToggleFormat"
                                                            Disabled="_loading" />
                                        </div>
                                        <div class="col-md-6">
                                            <PageOptions AllowTwoPages="_settings.AllowTwoPages"
                                                         AllowTwoPagesChanged="SetAllowTwoPages"
                                                         Disabled="_loading" />
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="form-section form-actions composer-nav">
                                @if (_step > 1)
                                {
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-lg composer-back-btn"
                                            disabled="@_loading"
                                            @onclick="() => GoToStepAsync(_step - 1)">
                                        <i class="bi bi-arrow-left me-1"></i>
                                        Back
                                    </button>
                                }
                                @if (_step < LastStep)
                                {
                                    <button type="button"
                                            class="btn btn-primary btn-lg generate-btn"
                                            @onclick="() => GoToStepAsync(_step + 1)">
                                        Next
                                        <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                }
                                else
                                {
                                    <GenerateButton Loading="_loading" Disabled="_loading" OnClick="GenerateAsync" />
                                }
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <ResultsWorkspace Analysis="_analysis"
                      Documents="_documents"
                      Loading="_loading"
                      Stage="_stage"
                      @bind-Editing="_showBulletEditor"
                      OnBack="BackToGenerate"
                      OnStartOver="ResetAsync"
                      OnDownload="DownloadAsync"
                      OnRegenerate="RegenerateAsync" />
}

@code {
    private const int LastStep = 3;

    private string _view = "generate";
    private int _step = 1;
    private string _jobDescription = string.Empty;
    private string _profileId = "cv-master";
    private List<ProfileInfo> _profiles = new() { new("cv-master", "Default") };
    private AppSettings _settings = new();
    private List<HistoryEntry> _history = new();
    private AnalysisResult? _analysis;
    private Dictionary<string, byte[]> _documents = new();
    private bool _loading;
    private GenerationStage _stage;
    private bool _showHistory;
    private bool _showBulletEditor;
    private string _error = string.Empty;
    private DotNetObjectReference<Home>? _selfRef;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profiles = CvService.ListProfiles();
            if (profiles.Count > 0)
            {
                _profiles = profiles;
                if (_profiles.All(p => p.Id != _profileId))
                    _profileId = _profiles[0].Id;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not list CV profiles; falling back to default.");
        }

        _settings = await Store.LoadSettingsAsync();
        _history = await Store.GetHistoryAsync();

        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("cvApp.registerShortcuts", _selfRef);
    }

    [JSInvokable]
    public Task OnPasteShortcut(string text) => InvokeAsync(() =>
    {
        if (_loading || _view != "generate") return;
        _jobDescription = text;
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnGenerateShortcut(string textareaValue) => InvokeAsync(async () =>
    {
        // The editor only exists on step 1; on later steps the text already lives in _jobDescription
        var text = string.IsNullOrWhiteSpace(textareaValue) ? _jobDescription : textareaValue;
        if (_view != "generate" || _loading || string.IsNullOrWhiteSpace(text)) return;
        _jobDescription = text;
        await GenerateAsync();
    });

    private Task GoToStepAsync(int step)
    {
        if (step > 1 && string.IsNullOrWhiteSpace(_jobDescription))
        {
            _step = 1;
            _error = "Please paste a job description";
            return Task.CompletedTask;
        }

        _error = string.Empty;
        _step = Math.Clamp(step, 1, LastStep);
        return Task.CompletedTask;
    }

    private async Task SetTemplate(string template)
    {
        _settings.Template = template;
        await Store.SaveSettingsAsync(_settings);
    }

    private async Task SetAllowTwoPages(bool value)
    {
        _settings.AllowTwoPages = value;
        await Store.SaveSettingsAsync(_settings);
    }

    private async Task ToggleFormat(string format)
    {
        _settings.SelectedFormats[format] = !(_settings.SelectedFormats.TryGetValue(format, out var v) && v);
        await Store.SaveSettingsAsync(_settings);
    }

    private List<string> SelectedFormats() =>
        _settings.SelectedFormats.Where(kv => kv.Value).Select(kv => kv.Key).ToList();

    private CVTemplate TemplateEnum() =>
        Enum.TryParse<CVTemplate>(_settings.Template, ignoreCase: true, out var t) ? t : CVTemplate.Harvard;

    private string TemplateLabel() => TemplateEnum().ToString();

    private async Task DownloadAsync(string format)
    {
        if (!_documents.TryGetValue(format, out var bytes)) return;

        using var stream = new MemoryStream(bytes);
        using var reference = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("cvApp.downloadFile", CvService.BuildFileName(format), reference);
    }

    private async Task GenerateAsync()
    {
        if (string.IsNullOrWhiteSpace(_jobDescription)) { _error = "Please paste a job description"; return; }
        if (SelectedFormats().Count == 0) { _error = "Please select at least one format"; return; }

        _error = string.Empty;
        _loading = true;
        _analysis = null;
        _documents = new();
        _showBulletEditor = false;
        _showHistory = false;
        _stage = GenerationStage.Parsing;
        _view = "details";
        StateHasChanged();

        // Progress<T> posts to the Blazor sync context, so the callback can touch component state directly
        var progress = new Progress<GenerationStage>(stage =>
        {
            _stage = stage;
            StateHasChanged();
        });

        try
        {
            var (documents, analysis) = await CvService.BuildCvAsync(new GenerateRequest
            {
                JobDescription = _jobDescription,
                Formats = SelectedFormats(),
                Template = TemplateEnum(),
                AllowTwoPages = _settings.AllowTwoPages,
                ProfileId = _profileId
            }, progress);

            _documents = documents;
            _analysis = analysis;
            _history = await Store.AddToHistoryAsync(_jobDescription, analysis.MatchScore.Overall, TemplateLabel());
        }
        catch (ArgumentException ex)
        {
            _view = "generate";
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating CV");
            _view = "generate";
            _error = "An error occurred while generating the CV";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RegenerateAsync((Dictionary<string, List<int>> Selections, GeneratedCV Cv) edit)
    {
        if (_analysis == null) return;

        _loading = true;
        _error = string.Empty;
        StateHasChanged();

        try
        {
            var (documents, previewHtml) = await CvService.RebuildCvAsync(new RegenerateRequest
            {
                GeneratedCV = edit.Cv,
                BulletSelections = edit.Selections,
                Formats = SelectedFormats(),
                Template = TemplateEnum(),
                AllowTwoPages = _settings.AllowTwoPages
            });

            _documents = documents;
            _analysis.GeneratedCV = edit.Cv;
            _analysis.PreviewHtml = previewHtml;
            _showBulletEditor = false;
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error regenerating CV");
            _error = "Error regenerating CV";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadHistoryEntry(HistoryEntry entry)
    {
        _jobDescription = entry.JobDescription;
        _step = 1;
        _showHistory = false;
        _error = string.Empty;
        await JS.InvokeVoidAsync("cvApp.scrollToTop");
    }

    private async Task DeleteHistoryEntry(long id) => _history = await Store.RemoveFromHistoryAsync(id);

    private async Task ClearHistory()
    {
        await Store.ClearHistoryAsync();
        _history = new();
    }

    private async Task BackToGenerate()
    {
        _view = "generate";
        _showHistory = false;
        _showBulletEditor = false;
        _error = string.Empty;
        await JS.InvokeVoidAsync("cvApp.scrollToTop");
    }

    private async Task ResetAsync()
    {
        var defaults = new AppSettings();
        _jobDescription = string.Empty;
        _settings.SelectedFormats = defaults.SelectedFormats;
        _settings.Template = defaults.Template;
        _settings.AllowTwoPages = defaults.AllowTwoPages;
        await Store.SaveSettingsAsync(_settings);

        _analysis = null;
        _documents = new();
        _showBulletEditor = false;
        _showHistory = false;
        _step = 1;
        _view = "generate";
        _error = string.Empty;
        await JS.InvokeVoidAsync("cvApp.scrollToTop");
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("cvApp.unregisterShortcuts");
        }
        catch (JSDisconnectedException)
        {
        }

        _selfRef?.Dispose();
    }
}
