@page "/"
@using System.Text.Json
@using static ErCv.Web.Services.CVGeneratorService
@implements IAsyncDisposable
@inject CVGeneratorService CvService
@inject BrowserStore Store
@inject IJSRuntime JS
@inject ILogger<Home> Logger
@inject ToastService Toasts

<PageTitle>@($"{UiConstants.AppName} - Resumes tailored to every job")</PageTitle>

<div class="visually-hidden" role="status" aria-live="polite">@_announcement</div>

@if (_view == ViewGenerate)
{
    <div class="container app-shell py-4 py-lg-5">
        <Hero />
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="card main-card">
                    <div class="card-body form-card-body">
                        @if (_showHistory)
                        {
                            <HistoryPanel Entries="_history"
                                          OnLoad="ReopenHistoryEntry"
                                          OnDelete="DeleteHistoryEntry"
                                          OnUpdate="SaveHistoryEntry"
                                          OnClear="ClearHistory"
                                          OnClose="() => _showHistory = false"
                                          Disabled="_loading" />
                        }
                        <form class="generator-form" @onsubmit:preventDefault>
                            <div class="form-title-row">
                                <h5 class="form-title mb-0">Generate Your CV</h5>
                                @if (_analysis != null)
                                {
                                    <button type="button" id="back-to-results" class="btn btn-outline-secondary btn-sm"
                                            disabled="@_loading" @onclick="BackToResults">
                                        <i class="bi bi-arrow-right me-1" aria-hidden="true"></i>Back to your CV
                                    </button>
                                }
                                <button type="button"
                                        class="btn btn-outline-secondary btn-sm history-toggle-btn"
                                        disabled="@_loading"
                                        @onclick="() => _showHistory = !_showHistory">
                                    @(_showHistory ? "Hide History" : "History")
                                </button>
                            </div>
                            <ComposerSteps Current="_step" OnGoTo="GoToStepAsync" Disabled="_loading" />
                            @if (_step == StepJobDescription)
                            {
                                <div class="form-section form-section-primary">
                                    <JobDescriptionInput @bind-Value="_jobDescription"
                                                         Error="@_jdError"
                                                         Disabled="_loading"
                                                         HelperText="Shortcuts: Ctrl/Cmd+Shift+V paste, Ctrl/Cmd+Enter generate" />
                                    <JobPostLink OnImport="s => _jobDescription = s" OnCompany="c => _company = c" Disabled="_loading" />
                                    <SampleJobPicker Current="@_jobDescription"
                                                     OnSelect="s => _jobDescription = s"
                                                     OnCompany="c => _company = c"
                                                     Disabled="_loading" />
                                    <div class="company-field">
                                        <label class="job-link-label" for="company">Company (optional, named in the cover letter):</label>
                                        <input id="company" type="text" class="form-control form-control-sm" autocomplete="off"
                                               placeholder="Left empty, the company the post names is used"
                                               maxlength="@ApiConstants.MaxCompanyLength" disabled="@_loading"
                                               @bind="_company" @bind:event="oninput" />
                                    </div>
                                </div>
                            }
                            else if (_step == StepProfile)
                            {
                                <div class="form-section form-section-primary">
                                    <ProfileSourceSwitcher Profiles="_profiles"
                                                           @bind-ProfileId="_profileId"
                                                           Value="@_settings.ProfileSource"
                                                           ValueChanged="SetProfileSource"
                                                           HasMine="_myProfile != null"
                                                           Disabled="_loading" />
                                    <TemplateSelector Value="@_settings.Template"
                                                      ValueChanged="SetTemplate"
                                                      Thumbnails="_thumbnails"
                                                      Disabled="_loading" />
                                    <StyleOptions Accent="@_settings.Accent"
                                                  AccentChanged="SetAccent"
                                                  Fonts="@_settings.Fonts"
                                                  FontsChanged="SetFonts"
                                                  Disabled="_loading" />
                                </div>
                            }
                            else
                            {
                                <div class="form-section form-section-primary">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <FormatSelector Selected="_settings.SelectedFormats"
                                                            Error="@_formatError"
                                                            OnToggle="ToggleFormat"
                                                            Disabled="_loading" />
                                        </div>
                                        <div class="col-md-6">
                                            <PageOptions AllowTwoPages="_settings.AllowTwoPages"
                                                         AllowTwoPagesChanged="SetAllowTwoPages"
                                                         Disabled="_loading" />
                                        </div>
                                        <div class="col-md-6">
                                            <LanguageOptions Value="@_settings.Language"
                                                             ValueChanged="SetLanguage"
                                                             Disabled="_loading" />
                                        </div>
                                        <div class="col-md-6">
                                            <CoverLetterOption Value="_settings.IncludeCoverLetter"
                                                               ValueChanged="SetIncludeCoverLetter"
                                                               Disabled="_loading" />
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="form-section form-actions composer-nav">
                                @if (_step > 1)
                                {
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-lg composer-back-btn"
                                            disabled="@_loading"
                                            @onclick="() => GoToStepAsync(_step - 1)">
                                        <i class="bi bi-arrow-left me-1"></i>
                                        Back
                                    </button>
                                }
                                @if (_step < LastStep)
                                {
                                    <button type="button"
                                            class="btn btn-primary btn-lg generate-btn"
                                            @onclick="() => GoToStepAsync(_step + 1)">
                                        Next
                                        <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                }
                                else
                                {
                                    <GenerateButton Loading="_loading" Disabled="_loading" OnClick="GenerateAsync" />
                                }
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <ResultsWorkspace Analysis="_analysis"
                      Documents="_documents"
                      Loading="_loading"
                      Progress="_progress"
                      RenderingLabel="@_renderingLabel"
                      @bind-Editing="_showBulletEditor"
                      OnBack="BackToGenerate"
                      OnStartOver="ResetAsync"
                      OnDownload="DownloadAsync"
                      OnDownloadLetter="DownloadLetterAsync"
                      Draft="_draft"
                      LetterDraft="_letterDraft"
                      LetterPageWarning="@_letterPageWarning"
                      OnLetterChanged="RefreshLetter"
                      OnCompanyChanged="ChangeCompany"
                      Template="_resultTemplate"
                      PageWarning="@_pageWarning"
                      ScoresUpdating="_scoresUpdating"
                      OnDraftChanged="OnDraftChanged" />
}

@code {
    #region Constants

    private const string ViewGenerate = "generate";

    // Toggles and moves come in bursts (Alt+Up/Down repeats): the scores are computed once the edits stop for this long
    private const int EditAnalysisDebounceMs = 400;
    private const string ViewDetails = "details";

    // Composer steps
    private const int StepJobDescription = 1;
    private const int StepProfile = 2;
    private const int LastStep = 3;

    // Page limit an edited PDF is checked against (it is printed as edited, never trimmed)
    private const int OnePage = 1;
    private const int LetterPages = 1;
    private const int TwoPages = 2;

    // Element ids the page moves focus to
    private const string ResultsRegionId = "results-region";
    private const string JobDescriptionId = "job-description";

    #endregion

    #region State

    private string _view = ViewGenerate;
    private int _step = StepJobDescription;
    private string _jobDescription = string.Empty;
    private string _profileId = ApiConstants.SeniorSampleProfileId;
    private CVMaster? _myProfile;
    private List<ProfileInfo> _profiles = new() { new(ApiConstants.DefaultProfileId, ApiConstants.DefaultProfileName) };
    private AppSettings _settings = new();
    private List<HistoryEntry> _history = new();
    private AnalysisResult? _analysis;
    private Dictionary<string, byte[]> _documents = new();
    private bool _loading;
    private GenerationStatus _progress = new(GenerationStage.Parsing, 0);

    // UX-11: what is being rendered for a download, so a bar shows and a second click does nothing
    private string? _renderingLabel;
    private bool _showHistory;
    private bool _showBulletEditor;

    // EDIT-01/02: the edits to the CV on screen and the options it was generated with
    private CvDraft? _draft;
    private string? _pageWarning;
    private CoverLetterDraft? _letterDraft;

    // EDIT-10: the letter is one page; an edited one that runs longer is told so, never trimmed
    private string? _letterPageWarning;

    // APP-09: the tracker entry the open result created, so editing its company updates the open letter
    private long _currentHistoryId;
    private int _letterMeasureVersion;

    // EDIT-09: the company the cover letter is for. An import or a sample fills it; typing in the post does not change it
    private string _company = string.Empty;

    // EDIT-08: the scores follow the edited CV. An edit starts a countdown; a newer edit cancels it
    private bool _scoresUpdating;
    private CancellationTokenSource? _reanalysis;
    private string _analyzedFingerprint = string.Empty;

    // Bumped by every edit and reset, so a slow page count never overwrites a newer one (EDIT-07)
    private int _measureVersion;
    private CVTemplate _resultTemplate;
    private string _resultJobDescription = string.Empty;
    private bool _resultTwoPages;
    private HashSet<string> _staleFormats = new();

    // UX-10: each template rendered with the sample profile in the chosen style, for the template picker
    private Dictionary<string, string> _thumbnails = new();
    private string? _jdError;
    private string? _formatError;
    private bool _focusJd;
    private bool _focusResults;
    private string _announcement = string.Empty;
    private DotNetObjectReference<Home>? _selfRef;

    #endregion

    #region Lifecycle

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profiles = CvService.ListProfiles();
            if (profiles.Count > 0)
            {
                _profiles = profiles;
                if (_profiles.All(p => p.Id != _profileId))
                    _profileId = _profiles[0].Id;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not list CV profiles; falling back to default.");
        }

        // Registered before the storage reads: each read is a round trip, and a shortcut pressed meanwhile was lost
        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync(UiConstants.JsRegisterShortcuts, _selfRef);

        _settings = await Store.LoadSettingsAsync();
        _history = await Store.GetHistoryAsync();
        _myProfile = await Store.LoadMyProfileAsync();
        if (_myProfile == null) _settings.ProfileSource = UiConstants.ProfileSourceDemo;

        await RefreshThumbnailsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Focus waits for the render that creates the target element
        if (_focusResults && _view == ViewDetails && _analysis != null)
        {
            _focusResults = false;
            await JS.InvokeVoidAsync(UiConstants.JsFocusElement, ResultsRegionId);
            return;
        }

        if (!_focusJd || _view != ViewGenerate || _step != StepJobDescription) return;

        _focusJd = false;
        await JS.InvokeVoidAsync(UiConstants.JsFocusElement, JobDescriptionId);
    }

    public async ValueTask DisposeAsync()
    {
        CancelReanalysis();
        try
        {
            await JS.InvokeVoidAsync(UiConstants.JsUnregisterShortcuts);
        }
        catch (JSDisconnectedException)
        {
        }

        _selfRef?.Dispose();
    }

    #endregion

    #region Event Handlers

    [JSInvokable]
    public Task OnPasteShortcut(string text) => InvokeAsync(() =>
    {
        if (_loading || _view != ViewGenerate) return;
        _jobDescription = text;
        Toasts.Info("Job description pasted");
        StateHasChanged();
    });

    [JSInvokable]
    public Task OnGenerateShortcut(string textareaValue) => InvokeAsync(async () =>
    {
        // The editor only exists on step 1; on later steps the text already lives in _jobDescription
        var text = string.IsNullOrWhiteSpace(textareaValue) ? _jobDescription : textareaValue;
        if (_view != ViewGenerate || _loading) return;

        _jobDescription = text;
        await GenerateAsync();

        // A JS-invoked method does not re-render on its own; validation errors need it
        StateHasChanged();
    });

    private Task GoToStepAsync(int step)
    {
        if (step > StepJobDescription && string.IsNullOrWhiteSpace(_jobDescription))
        {
            RequireJobDescription();
            return Task.CompletedTask;
        }

        _jdError = null;
        _step = Math.Clamp(step, StepJobDescription, LastStep);
        return Task.CompletedTask;
    }

    private async Task SetProfileSource(string source)
    {
        _settings.ProfileSource = source;
        await Store.SaveSettingsAsync(_settings);
    }

    private async Task SetTemplate(string template)
    {
        _settings.Template = template;
        await Store.SaveSettingsAsync(_settings);
    }

    private async Task SetAccent(string accent)
    {
        _settings.Accent = accent;
        await Store.SaveSettingsAsync(_settings);
        await RefreshThumbnailsAsync();
    }

    private async Task SetFonts(string fonts)
    {
        _settings.Fonts = fonts;
        await Store.SaveSettingsAsync(_settings);
        await RefreshThumbnailsAsync();
    }

    private async Task SetLanguage(string language)
    {
        _settings.Language = language;
        await Store.SaveSettingsAsync(_settings);
        await RefreshThumbnailsAsync();
    }

    private async Task SetIncludeCoverLetter(bool value)
    {
        _settings.IncludeCoverLetter = value;
        await Store.SaveSettingsAsync(_settings);
    }

    private async Task SetAllowTwoPages(bool value)
    {
        _settings.AllowTwoPages = value;
        await Store.SaveSettingsAsync(_settings);
    }

    private async Task ToggleFormat(string format)
    {
        _settings.SelectedFormats[format] = !(_settings.SelectedFormats.TryGetValue(format, out var v) && v);
        await Store.SaveSettingsAsync(_settings);
    }

    private async Task DownloadAsync(string format)
    {
        if (!_documents.TryGetValue(format, out var bytes) || _renderingLabel != null) return;

        try
        {
            if (_staleFormats.Contains(format))
            {
                _renderingLabel = $"Rendering {format.ToUpperInvariant()}...";
                StateHasChanged();
                bytes = await RenderEditedAsync(format);
            }

            using var stream = new MemoryStream(bytes);
            using var reference = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync(UiConstants.JsDownloadFile, BuildFileName(format), reference);
            Toasts.Success($"Download started: {format.ToUpperInvariant()}");
        }
        catch (ArgumentException ex)
        {
            Toasts.Error(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading {Format}", format);
            Toasts.Error($"Could not download the {format.ToUpperInvariant()} file", "Retry", () => DownloadAsync(format));
        }
        finally
        {
            _renderingLabel = null;
        }
    }

    private async Task DownloadLetterAsync(string format)
    {
        if (_analysis?.CoverLetter is not { } letter || _renderingLabel != null) return;

        try
        {
            _renderingLabel = $"Rendering the cover letter {format.ToUpperInvariant()}...";
            StateHasChanged();
            var bytes = await CvService.RenderCoverLetterAsync(letter, format);
            using var stream = new MemoryStream(bytes);
            using var reference = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync(UiConstants.JsDownloadFile, BuildFileName(format, ApiConstants.CoverLetterFileNamePrefix), reference);
            Toasts.Success($"Download started: cover letter {format.ToUpperInvariant()}");
        }
        catch (ArgumentException ex)
        {
            Toasts.Error(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error downloading the cover letter as {Format}", format);
            Toasts.Error($"Could not download the cover letter {format.ToUpperInvariant()}", "Retry", () => DownloadLetterAsync(format));
        }
        finally
        {
            _renderingLabel = null;
        }
    }

    private async Task GenerateAsync()
    {
        if (string.IsNullOrWhiteSpace(_jobDescription)) { RequireJobDescription(); return; }
        if (SelectedFormats().Count == 0) { _formatError = "Select at least one format"; return; }

        _jdError = null;
        _formatError = null;
        _loading = true;
        _analysis = null;
        _documents = new();
        _draft = null;
        _letterDraft = null;
        _letterPageWarning = null;
        _letterMeasureVersion++;
        _currentHistoryId = 0;
        _pageWarning = null;
        _measureVersion++;
        CancelReanalysis();
        _staleFormats = new();
        _showBulletEditor = false;
        _showHistory = false;
        _progress = new GenerationStatus(GenerationStage.Parsing, 0);
        _view = ViewDetails;
        StateHasChanged();

        // Progress<T> posts to the Blazor sync context, so the callback can touch component state directly
        var progress = new Progress<GenerationStatus>(value =>
        {
            _progress = value;
            StateHasChanged();
        });

        try
        {
            var request = new GenerateRequest
            {
                JobDescription = _jobDescription,
                Formats = SelectedFormats(),
                Template = TemplateEnum(),
                AllowTwoPages = _settings.AllowTwoPages,
                ProfileId = _profileId,
                Language = _settings.Language,
                Accent = _settings.Accent,
                Fonts = _settings.Fonts,
                IncludeCoverLetter = _settings.IncludeCoverLetter,
                Company = _company
            };

            var (documents, analysis) = ActiveProfile is { } profile
                ? await CvService.BuildCvAsync(request, profile, progress)
                : await CvService.BuildCvAsync(request, progress);

            _documents = documents;
            _analysis = analysis;
            _resultTemplate = request.Template;
            _resultTwoPages = request.AllowTwoPages;
            _resultJobDescription = request.JobDescription;
            // The profile the CV was made from, so the editor can offer what the selection left out (EDIT-07)
            var source = ActiveProfile ?? await CvService.GetProfileAsync(_profileId);
            _draft = new CvDraft(analysis.GeneratedCV, DocumentRenderer.DefaultSectionOrder(request.Template), source);
            _letterDraft = analysis.CoverLetter is { } letter ? new CoverLetterDraft(letter) : null;
            _letterPageWarning = null;
            _letterMeasureVersion++;
            _pageWarning = null;
            _measureVersion++;
            CancelReanalysis();
            _analyzedFingerprint = Fingerprint(analysis.GeneratedCV);
            _focusResults = true;
            Toasts.Success("CV ready");
            _announcement = $"CV ready. Match score {analysis.MatchScore.Overall} percent. ATS score {analysis.ATSScore.Overall} out of {ATSConstants.MaxScore}.";
            _history = await Store.AddToHistoryAsync(_jobDescription, analysis.MatchScore.Overall, TemplateLabel(), new HistoryEntry
            {
                TemplateKey = _settings.Template,
                Formats = SelectedFormats(),
                AllowTwoPages = _settings.AllowTwoPages,
                ProfileSource = _settings.ProfileSource,
                ProfileId = _profileId,
                Language = _settings.Language,
                Accent = _settings.Accent,
                Fonts = _settings.Fonts,
                IncludeCoverLetter = _settings.IncludeCoverLetter,
                Company = analysis.Company ?? string.Empty
            });
            _currentHistoryId = _history.FirstOrDefault()?.Id ?? 0;
        }
        catch (ArgumentException ex)
        {
            _view = ViewGenerate;
            Toasts.Error(ex.Message);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error generating CV");
            _view = ViewGenerate;
            Toasts.Error("Something went wrong while generating the CV", "Retry", GenerateAsync);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>EDIT-02: every edit re-renders the preview HTML only; the documents are rebuilt when downloaded.</summary>
    private async Task OnDraftChanged()
    {
        if (_analysis == null || _draft == null) return;

        var cv = _draft.Build();
        var version = ++_measureVersion;
        try
        {
            _analysis.PreviewHtml = CvService.RenderPreviewHtml(cv, _resultTemplate);
            _analysis.GeneratedCV = cv;
            _staleFormats = _documents.Keys.ToHashSet();

            // The letter quotes the CV, so it is written again from the edited one; what the visitor wrote stays
            WriteLetter(cv, _analysis.Company);
        }
        catch (ArgumentException ex)
        {
            Toasts.Error(ex.Message);
            return;
        }

        ScheduleReanalysis(cv);
        await MeasureLetterPagesAsync();
        await MeasurePagesAsync(cv, version);
    }

    /// <summary>
    /// EDIT-08: match, gaps, keywords, ATS and the job post's highlights follow the edited CV. Only what the analysis
    /// reads counts as a change (moving a section does not), and the work waits for the edits to pause.
    /// </summary>
    private void ScheduleReanalysis(GeneratedCV cv)
    {
        if (_analysis?.Context is not { } context) return;

        CancelReanalysis();
        if (Fingerprint(cv) == _analyzedFingerprint) return;

        _reanalysis = new CancellationTokenSource();
        _scoresUpdating = true;
        _ = ReanalyzeAsync(cv, context, _reanalysis.Token);
    }

    private async Task ReanalyzeAsync(GeneratedCV cv, AnalysisContext context, CancellationToken token)
    {
        try
        {
            await Task.Delay(EditAnalysisDebounceMs, token);
            var result = CvService.AnalyzeEdited(cv, context, _resultTemplate);
            if (token.IsCancellationRequested || _analysis == null) return;

            _analysis.MatchScore = result.MatchScore;
            _analysis.MissingSkills = result.MissingSkills;
            _analysis.KeywordAnalysis = result.KeywordAnalysis;
            _analysis.ATSScore = result.ATSScore;
            _analysis.JdHighlight = result.JdHighlight;
            _analyzedFingerprint = Fingerprint(cv);
            _scoresUpdating = false;
        }
        catch (OperationCanceledException)
        {
            return; // a newer edit took over
        }
        catch (ArgumentException ex)
        {
            Toasts.Error(ex.Message);
            _scoresUpdating = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void CancelReanalysis()
    {
        _reanalysis?.Cancel();
        _reanalysis?.Dispose();
        _reanalysis = null;
        _scoresUpdating = false;
    }

    // What the analysis reads of the CV; the order of its sections is not part of it
    private static string Fingerprint(GeneratedCV cv) =>
        JsonSerializer.Serialize(new { cv.Summary, cv.Skills, cv.Experience, cv.Projects, cv.Education });

    /// <summary>EDIT-09: writes the letter again for this CV and company; the draft keeps the visitor's edits over it.</summary>
    private void WriteLetter(GeneratedCV cv, string? company)
    {
        if (_analysis?.CoverLetter == null || _letterDraft == null) return;

        var (generated, _) = CvService.BuildCoverLetter(cv, _resultJobDescription, company);
        _letterDraft.Update(generated);
        _analysis.Company = generated.Company;
        ApplyLetter();
    }

    private void ApplyLetter()
    {
        if (_analysis == null || _letterDraft == null) return;

        var letter = _letterDraft.Build();
        _analysis.CoverLetter = letter;
        _analysis.CoverLetterHtml = CvService.RenderCoverLetterHtml(letter);
    }

    /// <summary>The visitor edited a part of the letter: the preview and the downloads follow.</summary>
    private async Task RefreshLetter()
    {
        try
        {
            ApplyLetter();
        }
        catch (ArgumentException ex)
        {
            Toasts.Error(ex.Message);
            return;
        }

        await MeasureLetterPagesAsync();
    }

    private async Task ChangeCompany(string company)
    {
        if (_analysis == null) return;

        try
        {
            WriteLetter(_analysis.GeneratedCV, company);
        }
        catch (ArgumentException ex)
        {
            Toasts.Error(ex.Message);
            return;
        }

        await MeasureLetterPagesAsync();
    }

    /// <summary>
    /// EDIT-10: a letter the visitor wrote in can run past one page. The page count is measured on the real PDF, only
    /// while the letter has edits or a warning is showing, and nothing is trimmed: the visitor gets the count.
    /// </summary>
    private async Task MeasureLetterPagesAsync()
    {
        var version = ++_letterMeasureVersion;
        if (_analysis?.CoverLetter is not { } letter || _letterDraft is not { } draft) return;
        if (!draft.IsChanged && _letterPageWarning == null) return;

        try
        {
            var pdf = await CvService.RenderCoverLetterAsync(letter, ApiConstants.FormatPdf);
            if (version != _letterMeasureVersion) return;

            var pages = DocumentRenderer.CountPages(pdf);
            _letterPageWarning = pages > LetterPages
                ? $"The letter now has {pages} pages. Shorten it to bring it back to {LetterPages}."
                : null;
        }
        catch (Exception ex) when (ex is ArgumentException or IOException or InvalidOperationException)
        {
            // The count is a help; the edit itself already worked
            Logger.LogWarning(ex, "Could not measure the edited letter's pages");
        }
    }

    /// <summary>
    /// EDIT-07: what the visitor added back can push the CV past its page limit. The page count is measured on the real
    /// PDF (as in MATCH-08), only while something is added or a warning is showing. Nothing is ever left out for the
    /// visitor: they get the count and decide.
    /// </summary>
    private async Task MeasurePagesAsync(GeneratedCV cv, int version)
    {
        if (_draft is not { HasAdditions: true } && _pageWarning == null) return;

        try
        {
            var (bytes, pages) = await CvService.RenderEditedDocumentAsync(cv, _resultTemplate, ApiConstants.FormatPdf);
            if (version != _measureVersion) return;

            var maxPages = _resultTwoPages ? TwoPages : OnePage;
            _pageWarning = pages > maxPages
                ? $"The CV now has {pages} pages, over the {maxPages}-page limit. Leave something out to bring it back."
                : null;

            // The PDF the visitor asked for is already built, so the download does not render it again
            if (_documents.ContainsKey(ApiConstants.FormatPdf))
            {
                _documents[ApiConstants.FormatPdf] = bytes;
                _staleFormats.Remove(ApiConstants.FormatPdf);
            }
        }
        catch (Exception ex) when (ex is ArgumentException or IOException or InvalidOperationException)
        {
            // The count is a help; the edit itself already worked
            Logger.LogWarning(ex, "Could not measure the edited CV's pages");
        }
    }

    /// <summary>APP-02: puts the saved job description and options back and generates again.</summary>
    private async Task ReopenHistoryEntry(HistoryEntry entry)
    {
        _jobDescription = entry.JobDescription;
        _company = entry.Company;
        _jdError = null;

        if (entry.TemplateKey != null) _settings.Template = entry.TemplateKey;
        if (entry.AllowTwoPages is { } twoPages) _settings.AllowTwoPages = twoPages;
        if (entry.Formats is { Count: > 0 } formats)
            _settings.SelectedFormats = _settings.SelectedFormats.Keys.ToDictionary(k => k, k => formats.Contains(k));
        if (entry.Language is { } language && ApiConstants.Languages.Contains(language)) _settings.Language = language;
        if (entry.Accent is { } accent && ApiConstants.Accents.Contains(accent)) _settings.Accent = accent;
        if (entry.Fonts is { } fonts && ApiConstants.FontPairings.Contains(fonts)) _settings.Fonts = fonts;
        if (entry.IncludeCoverLetter is { } letter) _settings.IncludeCoverLetter = letter;

        var note = RestoreProfile(entry);
        await Store.SaveSettingsAsync(_settings);

        if (note != null) Toasts.Info(note);
        await GenerateAsync();
    }

    private async Task SaveHistoryEntry(HistoryEntry entry)
    {
        await Store.UpdateHistoryEntryAsync(entry);
        Toasts.Success("Application updated");

        // APP-09: the tracker's company is the letter's company for the result that created the entry
        if (entry.Id == _currentHistoryId && _letterDraft != null && _analysis != null
            && !string.Equals(entry.Company?.Trim() ?? string.Empty, _analysis.Company ?? string.Empty, StringComparison.Ordinal))
            await ChangeCompany(entry.Company ?? string.Empty);
    }

    private async Task DeleteHistoryEntry(long id)
    {
        _history = await Store.RemoveFromHistoryAsync(id);
        Toasts.Success("Removed from history");
    }

    private async Task ClearHistory()
    {
        await Store.ClearHistoryAsync();
        _history = new();
        Toasts.Success("History cleared");
    }

    /// <summary>Back to the result that is still open, from the composer (where the history is).</summary>
    private void BackToResults()
    {
        _showHistory = false;
        _view = ViewDetails;
        _focusResults = true;
    }

    private async Task BackToGenerate()
    {
        _view = ViewGenerate;
        _showHistory = false;
        _showBulletEditor = false;
        await JS.InvokeVoidAsync(UiConstants.JsScrollToTop);
    }

    private async Task ResetAsync()
    {
        var defaults = new AppSettings();
        _jobDescription = string.Empty;
        _company = string.Empty;
        _settings.SelectedFormats = defaults.SelectedFormats;
        _settings.Template = defaults.Template;
        _settings.AllowTwoPages = defaults.AllowTwoPages;
        _settings.Language = defaults.Language;
        _settings.Accent = defaults.Accent;
        _settings.Fonts = defaults.Fonts;
        _settings.IncludeCoverLetter = defaults.IncludeCoverLetter;
        await Store.SaveSettingsAsync(_settings);
        await RefreshThumbnailsAsync();

        _analysis = null;
        _documents = new();
        _draft = null;
        _letterDraft = null;
        _letterPageWarning = null;
        _letterMeasureVersion++;
        _currentHistoryId = 0;
        _pageWarning = null;
        _measureVersion++;
        CancelReanalysis();
        _staleFormats = new();
        _showBulletEditor = false;
        _showHistory = false;
        _step = StepJobDescription;
        _view = ViewGenerate;
        _jdError = null;
        _formatError = null;
        Toasts.Info("Started over");
        await JS.InvokeVoidAsync(UiConstants.JsScrollToTop);
    }

    #endregion

    #region Helpers

    private async Task RefreshThumbnailsAsync()
    {
        try
        {
            var thumbnails = new Dictionary<string, string>();
            foreach (var option in TemplateSelector.Templates)
            {
                var template = Enum.Parse<CVTemplate>(option.Key, ignoreCase: true);
                thumbnails[option.Key] = await CvService.RenderTemplateSampleAsync(
                    template, _settings.Accent, _settings.Fonts, _settings.Language);
            }
            _thumbnails = thumbnails;
        }
        catch (Exception ex) when (ex is ArgumentException or IOException)
        {
            // The picker still works without thumbnails; the cards show their names
            Logger.LogWarning(ex, "Could not render the template thumbnails");
            _thumbnails = new();
        }
    }

    /// <summary>Renders one document of the edited CV and says when an edited PDF runs past the page limit.</summary>
    private async Task<byte[]> RenderEditedAsync(string format)
    {
        var (bytes, pages) = await CvService.RenderEditedDocumentAsync(_analysis!.GeneratedCV, _resultTemplate, format);
        _documents[format] = bytes;
        _staleFormats.Remove(format);

        var maxPages = _resultTwoPages ? TwoPages : OnePage;
        if (pages > maxPages)
            Toasts.Info($"The edited PDF has {pages} pages. Leave out a few bullets to bring it back to {maxPages}.");

        return bytes;
    }

    /// <summary>The profile sent with the request: the saved "My profile" if selected. Null means the stored profile chosen in step 2.</summary>
    private CVMaster? ActiveProfile => _settings.ProfileSource == UiConstants.ProfileSourceMine ? _myProfile : null;

    private void RequireJobDescription()
    {
        _step = StepJobDescription;
        _jdError = "Paste a job description to continue";
        _focusJd = true;
    }

    private List<string> SelectedFormats() =>
        _settings.SelectedFormats.Where(kv => kv.Value).Select(kv => kv.Key).ToList();

    private CVTemplate TemplateEnum() =>
        Enum.TryParse<CVTemplate>(_settings.Template, ignoreCase: true, out var t) ? t : CVTemplate.Harvard;

    private string TemplateLabel() => TemplateEnum().ToString();

    /// <summary>Returns a message when the profile the entry used is gone and a stored profile is used instead.</summary>
    private string? RestoreProfile(HistoryEntry entry)
    {
        if (entry.ProfileSource == null) return null;

        if (entry.ProfileId != null && _profiles.Any(p => p.Id == entry.ProfileId))
            _profileId = entry.ProfileId;

        if (entry.ProfileSource == UiConstants.ProfileSourceMine && _myProfile != null)
        {
            _settings.ProfileSource = UiConstants.ProfileSourceMine;
            return null;
        }

        _settings.ProfileSource = UiConstants.ProfileSourceDemo;
        return entry.ProfileSource switch
        {
            UiConstants.ProfileSourceImported => "The imported profile was not kept, so a sample profile was used.",
            UiConstants.ProfileSourceMine => "Your saved profile was not found, so a sample profile was used.",
            _ => null
        };
    }

    #endregion
