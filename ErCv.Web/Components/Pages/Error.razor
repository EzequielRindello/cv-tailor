@page "/Error"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>Error</PageTitle>

@* Target of UseExceptionHandler outside Development. Never shows exception details. *@
<div class="text-center mt-5">
    <h1 class="h4">Something went wrong</h1>
    <p>The request could not be completed. Please go back and try again.</p>
    <a href="/">Back to @UiConstants.AppName</a>
</div>
