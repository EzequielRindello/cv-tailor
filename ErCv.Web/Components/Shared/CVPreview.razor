@if (!string.IsNullOrEmpty(Html))
{
    <div class="card main-card mb-4">
        <div class="card-body p-3">
            <h5 class="mb-3">CV Preview</h5>
            <div class="cv-preview-frame-wrapper">
                <iframe srcdoc="@_normalizedHtml"
                        title="CV Preview"
                        class="cv-preview-frame"
                        sandbox="allow-same-origin"></iframe>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Html { get; set; }

    private string? _sourceHtml;
    private string _normalizedHtml = string.Empty;

    private const string ViewportMeta = "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">";

    // Modern template uses a 2-column grid that can overflow in the iframe preview.
    private const string PreviewFixStyle = """
        <style id="cv-preview-fix">
          html, body { max-width: 100% !important; overflow-x: hidden !important; }
          body { margin: 0 auto !important; padding: 12px !important; }
          a, p, span, div, li { overflow-wrap: anywhere; }
          .body-grid {
            width: 100% !important;
            grid-template-columns: minmax(0, 38%) minmax(0, 1fr) !important;
            column-gap: 10pt !important;
          }
          .left-col, .right-col { min-width: 0 !important; }
          .exp-header { flex-wrap: wrap; gap: 2pt 8pt; }
          .exp-dates { white-space: normal !important; }
          @media (max-width: 860px) {
            .body-grid { grid-template-columns: 1fr !important; row-gap: 8pt !important; }
            .left-col { border-right: 0 !important; padding-right: 0 !important; }
          }
        </style>
        """;

    protected override void OnParametersSet()
    {
        if (Html == _sourceHtml) return;

        _sourceHtml = Html;
        _normalizedHtml = Normalize(Html ?? string.Empty);
    }

    private static string Normalize(string html)
    {
        if (!Regex.IsMatch(html, "<meta[^>]*name=[\"']viewport[\"'][^>]*>", RegexOptions.IgnoreCase))
        {
            html = Regex.IsMatch(html, "<head[^>]*>", RegexOptions.IgnoreCase)
                ? Regex.Replace(html, "<head([^>]*)>", $"<head$1>\n{ViewportMeta}", RegexOptions.IgnoreCase)
                : $"{ViewportMeta}\n{html}";
        }

        if (!Regex.IsMatch(html, "id=[\"']cv-preview-fix[\"']", RegexOptions.IgnoreCase))
        {
            html = Regex.IsMatch(html, "</head>", RegexOptions.IgnoreCase)
                ? Regex.Replace(html, "</head>", PreviewFixStyle.Replace("$", "$$") + "\n</head>", RegexOptions.IgnoreCase)
                : $"{PreviewFixStyle}\n{html}";
        }

        return html;
    }
}
