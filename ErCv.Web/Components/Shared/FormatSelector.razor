<div class="mb-4">
    <span class="form-label form-label-custom mb-3 d-block" id="format-label">Select Format(s)</span>
    <div class="format-options" role="group" aria-labelledby="format-label">
        @foreach (var format in Formats)
        {
            <label class="format-card @(IsSelected(format.Key) ? "selected" : "")">
                <div class="format-icon" aria-hidden="true">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        @if (format.Key == ApiConstants.FormatPdf)
                        {
                            <polyline points="10 9 9 9 8 9"></polyline>
                        }
                        else
                        {
                            <line x1="12" y1="9" x2="8" y2="9"></line>
                        }
                    </svg>
                </div>
                <div class="format-name">@format.Name</div>
                <input type="checkbox"
                       class="form-check-input format-checkbox"
                       checked="@IsSelected(format.Key)"
                       disabled="@Disabled"
                       @onchange="() => Toggle(format.Key)" />
            </label>
        }
    </div>
    @if (ShowError)
    {
        <div class="field-error" role="alert">
            <i class="bi bi-exclamation-circle-fill" aria-hidden="true"></i>
            @Error
        </div>
    }
</div>

@code {
    #region Constants

    private static readonly FormatOption[] Formats =
    {
        new(ApiConstants.FormatPdf, "PDF"),
        new(ApiConstants.FormatDocx, "Word")
    };

    #endregion

    #region Parameters

    [Parameter] public Dictionary<string, bool> Selected { get; set; } = new();
    [Parameter] public EventCallback<string> OnToggle { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Shown under the cards while no format is selected.</summary>
    [Parameter] public string? Error { get; set; }

    #endregion

    #region Event Handlers

    private async Task Toggle(string key)
    {
        if (!Disabled) await OnToggle.InvokeAsync(key);
    }

    #endregion

    #region Helpers

    private bool ShowError => !string.IsNullOrEmpty(Error) && !Selected.Values.Any(v => v);

    private bool IsSelected(string key) => Selected.TryGetValue(key, out var v) && v;

    #endregion
}
