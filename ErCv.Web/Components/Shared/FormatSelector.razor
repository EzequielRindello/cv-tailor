<div class="mb-4">
    <label class="form-label form-label-custom mb-3">Select Format(s)</label>
    <div class="format-options">
        @foreach (var format in Formats)
        {
            <div class="format-card @(IsSelected(format.Key) ? "selected" : "")"
                 @onclick="() => Toggle(format.Key)">
                <div class="format-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        @if (format.Key == "pdf")
                        {
                            <polyline points="10 9 9 9 8 9"></polyline>
                        }
                        else
                        {
                            <line x1="12" y1="9" x2="8" y2="9"></line>
                        }
                    </svg>
                </div>
                <div class="format-name">@format.Name</div>
                <input type="checkbox"
                       class="form-check-input format-checkbox"
                       checked="@IsSelected(format.Key)"
                       disabled="@Disabled"
                       @onclick:stopPropagation="true"
                       @onchange="() => Toggle(format.Key)" />
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Dictionary<string, bool> Selected { get; set; } = new();
    [Parameter] public EventCallback<string> OnToggle { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private static readonly FormatOption[] Formats = { new("pdf", "PDF"), new("docx", "Word") };

    private bool IsSelected(string key) => Selected.TryGetValue(key, out var v) && v;

    private async Task Toggle(string key)
    {
        if (!Disabled) await OnToggle.InvokeAsync(key);
    }
}
