<div class="gen-progress" role="status" aria-live="polite">
    <progress class="gen-bar" id="gen-bar" max="100" value="@Value.Percent" aria-label="Generating your CV">@Value.Percent%</progress>
    <ol class="gen-steps">
        @foreach (var step in Steps)
        {
            var state = step.Stage < Value.Stage ? "done" : step.Stage == Value.Stage ? "current" : "todo";
            <li class="gen-step @state">
                <span class="gen-step-dot" aria-hidden="true">
                    @if (state == "done")
                    {
                        <i class="bi bi-check-lg"></i>
                    }
                    else if (state == "current")
                    {
                        <span class="spinner-border spinner-border-sm" role="presentation"></span>
                    }
                </span>
                <span class="gen-step-label">@step.Label</span>
            </li>
        }
    </ol>
    @if (Value.Detail != null)
    {
        <span class="gen-detail" id="gen-detail">@Value.Detail</span>
    }
    <span class="visually-hidden">@CurrentLabel, step @((int)Value.Stage + 1) of @Steps.Length, @Value.Percent percent</span>
</div>

@code {
    #region Constants

    private static readonly (GenerationStage Stage, string Label)[] Steps =
    {
        (GenerationStage.Parsing, "Parsing"),
        (GenerationStage.Selecting, "Selecting"),
        (GenerationStage.Rendering, "Rendering"),
        (GenerationStage.Scoring, "Scoring")
    };

    #endregion

    #region Parameters

    [Parameter] public GenerationStatus Value { get; set; } = new(GenerationStage.Parsing, 0);

    #endregion

    #region Helpers

    private string CurrentLabel => Steps[(int)Value.Stage].Label;

    #endregion
}
