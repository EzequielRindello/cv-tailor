<div class="profile-field @CssClass">
    <label class="form-label form-label-custom" for="@Id">@Label</label>
    @if (Multiline)
    {
        <textarea id="@Id" class="form-control @(Error != null ? "is-invalid" : "")" rows="2"
                  aria-invalid="@(Error != null ? "true" : null)"
                  aria-describedby="@(Error != null ? Id + "-err" : null)"
                  value="@Value" @oninput="OnInput" @onchange="OnChange" @onblur="OnBlur"></textarea>
    }
    else
    {
        <input id="@Id" class="form-control @(Error != null ? "is-invalid" : "")" type="text"
               placeholder="@Placeholder"
               aria-invalid="@(Error != null ? "true" : null)"
               aria-describedby="@(Error != null ? Id + "-err" : null)"
               value="@Value" @oninput="OnInput" @onchange="OnChange" @onblur="OnBlur" />
    }
    @if (Error != null)
    {
        <div class="profile-field-error" id="@(Id + "-err")">@Error</div>
    }
</div>

@code {
    #region Parameters

    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Multiline { get; set; }
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Set by the profile page: true while typing (the value reaches the model only on change), false on change or blur.</summary>
    [CascadingParameter(Name = UiConstants.ProfileEditedCascade)] public Action<bool>? Edited { get; set; }

    #endregion

    #region Event Handlers

    private void OnInput() => Edited?.Invoke(true);

    // Typed and erased again before leaving: the browser raises no change, so leaving the field ends the typing too
    private void OnBlur() => Edited?.Invoke(false);

    private async Task OnChange(ChangeEventArgs e)
    {
        await ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
        Edited?.Invoke(false);
    }

    #endregion
}
