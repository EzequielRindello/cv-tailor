@{
    var hasAnything = Data.RequiredMissing.Count > 0 || Data.NiceToHaveMissing.Count > 0;
    var total = Data.RequiredMissing.Count + Data.NiceToHaveMissing.Count;
}

<div class="card missing-skills-card">
    <div class="card-body">
        @if (!hasAnything)
        {
            <div class="missing-card-header">
                <h5 class="missing-card-title">
                    <i class="bi bi-check-circle-fill missing-title-icon ok"></i>
                    Skills Coverage
                </h5>
            </div>
            <p class="all-clear-text">All required skills are present in your CV Master!</p>
        }
        else
        {
            <div class="missing-card-header mb-3" @onclick="() => _open = !_open">
                <h5 class="missing-card-title">
                    <i class="bi bi-exclamation-triangle-fill missing-title-icon warn"></i>
                    Missing Skills (@total)
                </h5>
                <span class="toggle-icon">
                    <i class="bi @(_open ? "bi-chevron-up" : "bi-chevron-down")"></i>
                </span>
            </div>

            @if (Data.PotentialScoreIncrease > 0)
            {
                <div class="gain-callout">
                    <span class="gain-icon" aria-hidden="true"><i class="bi bi-graph-up-arrow"></i></span>
                    <p class="gain-text">
                        Adding the missing skills could raise your match score by up to
                        <strong class="gain-figure">+@Data.PotentialScoreIncrease%</strong>
                    </p>
                </div>
            }

            @if (_open)
            {
                <div style="margin-top: var(--spacing-md)">
                    <div class="skill-legend" aria-hidden="true">
                        <span><i class="skill-legend-dot required"></i>Required</span>
                        <span><i class="skill-legend-dot nice"></i>Nice to have</span>
                    </div>
                    <ul class="skill-cloud" aria-label="Missing skills">
                        @foreach (var s in Data.RequiredMissing)
                        {
                            <li class="skill-pill required"><span class="visually-hidden">Required: </span>@s</li>
                        }
                        @foreach (var s in Data.NiceToHaveMissing)
                        {
                            <li class="skill-pill nice"><span class="visually-hidden">Nice to have: </span>@s</li>
                        }
                    </ul>

                    @if (Data.Suggestions.Count > 0)
                    {
                        <div class="suggestions">
                            <div class="group-label">Suggestions</div>
                            <ul class="suggestion-list">
                                @foreach (var s in Data.Suggestions)
                                {
                                    <li>@s</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public MissingSkillsAnalysis Data { get; set; } = new();

    private bool _open = true;
}
