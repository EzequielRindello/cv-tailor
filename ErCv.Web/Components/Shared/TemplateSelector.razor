<div class="mb-4">
    <label class="form-label form-label-custom mb-3">Resume Template</label>
    <div class="template-options">
        @foreach (var t in Templates)
        {
            <div class="template-card @(Value == t.Key ? "selected" : "") @(Disabled ? "disabled" : "")"
                 @onclick="() => Select(t.Key)">
                <div class="template-preview">@Preview(t.Key)</div>
                <div class="template-info">
                    <div class="template-name">@t.Name</div>
                    <div class="template-desc">@t.Description</div>
                </div>
                @if (Value == t.Key)
                {
                    <div class="template-check">✓</div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private static readonly TemplateOption[] Templates =
    {
        new("harvard", "Harvard", "Classic • ATS-safe"),
        new("modern", "Modern", "2-column • Color accent"),
        new("minimalist", "Minimalist", "Clean • Lots of space")
    };

    private async Task Select(string key)
    {
        if (!Disabled) await ValueChanged.InvokeAsync(key);
    }

    private RenderFragment Preview(string key) => key switch
    {
        "modern" => @<svg viewBox="0 0 60 80" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="60" height="80" fill="white" />
            <rect width="60" height="12" fill="#2563eb" />
            <rect x="4" y="3" width="28" height="3" rx="1" fill="white" />
            <rect x="4" y="8" width="40" height="1.5" rx="0.5" fill="rgba(255,255,255,0.7)" />
            <rect x="4" y="16" width="18" height="1" fill="#2563eb" />
            <rect x="4" y="19" width="14" height="1.5" rx="0.5" fill="#dbeafe" />
            <rect x="4" y="22" width="16" height="1.5" rx="0.5" fill="#dbeafe" />
            <rect x="4" y="25" width="12" height="1.5" rx="0.5" fill="#dbeafe" />
            <rect x="4" y="31" width="18" height="1" fill="#2563eb" />
            <rect x="4" y="34" width="15" height="1.5" rx="0.5" fill="#888" />
            <rect x="4" y="37" width="14" height="1.5" rx="0.5" fill="#aaa" />
            <rect x="26" y="16" width="30" height="1" fill="#2563eb" />
            <rect x="26" y="19" width="22" height="2" rx="1" fill="#444" />
            <rect x="26" y="23" width="30" height="1.5" rx="0.5" fill="#888" />
            <rect x="26" y="26" width="28" height="1.5" rx="0.5" fill="#888" />
            <rect x="26" y="33" width="30" height="1" fill="#2563eb" />
            <rect x="26" y="36" width="20" height="2" rx="1" fill="#444" />
            <rect x="26" y="40" width="29" height="1.5" rx="0.5" fill="#888" />
            <rect x="26" y="43" width="27" height="1.5" rx="0.5" fill="#888" />
            <rect x="26" y="46" width="30" height="1.5" rx="0.5" fill="#888" />
        </svg>,
        "minimalist" => @<svg viewBox="0 0 60 80" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="60" height="80" fill="white" />
            <rect x="6" y="6" width="48" height="4" rx="1" fill="#111" opacity="0.7" />
            <rect x="6" y="12" width="44" height="1.5" rx="0.5" fill="#aaa" />
            <rect x="6" y="16" width="44" height="0.5" fill="#ccc" />
            <rect x="6" y="20" width="14" height="1" rx="0.5" fill="#bbb" />
            <rect x="6" y="23" width="38" height="1.5" rx="0.5" fill="#888" />
            <rect x="6" y="26" width="36" height="1.5" rx="0.5" fill="#888" />
            <rect x="6" y="32" width="14" height="1" rx="0.5" fill="#bbb" />
            <rect x="6" y="35" width="20" height="2" rx="1" fill="#555" />
            <rect x="6" y="39" width="15" height="1.5" rx="0.5" fill="#aaa" />
            <rect x="6" y="43" width="36" height="1.5" rx="0.5" fill="#888" />
