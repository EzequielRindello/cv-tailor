<div class="mb-4">
    <span class="form-label form-label-custom mb-3 d-block" id="template-label">Resume Template</span>
    <div class="template-options" role="radiogroup" aria-labelledby="template-label">
        @foreach (var t in Templates)
        {
            var selected = Value == t.Key;
            <label class="template-card @(selected ? "selected" : "") @(Disabled ? "disabled" : "")">
                <input type="radio"
                       class="visually-hidden"
                       name="resume-template"
                       value="@t.Key"
                       checked="@selected"
                       disabled="@Disabled"
                       @onchange="() => Select(t.Key)" />
                <div class="template-preview" aria-hidden="true">@Preview(t.Key)</div>
                <div class="template-info">
                    <div class="template-name">@t.Name</div>
                    <div class="template-desc">@t.Description</div>
                </div>
                @if (selected)
                {
                    <div class="template-check" aria-hidden="true">✓</div>
                }
            </label>
        }
    </div>
</div>

@code {
    #region Constants

    private static readonly TemplateOption[] Templates =
    {
        new(UiConstants.TemplateHarvard, "Harvard", "Classic • ATS-safe"),
        new(UiConstants.TemplateModern, "Modern", "2-column • Color accent"),
        new(UiConstants.TemplateMinimalist, "Minimalist", "Clean • Lots of space")
    };

    #endregion

    #region Parameters

    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    #endregion

    #region Event Handlers

    private async Task Select(string key)
    {
        if (!Disabled) await ValueChanged.InvokeAsync(key);
    }

    #endregion

    #region Helpers

    private RenderFragment Preview(string key) => key switch
    {
