<div class="mb-4">
    <span class="form-label form-label-custom mb-3 d-block" id="template-label">Resume Template</span>
    <div class="template-options" role="radiogroup" aria-labelledby="template-label">
        @foreach (var t in Templates)
        {
            var selected = Value == t.Key;
            <label class="template-card @(selected ? "selected" : "") @(Disabled ? "disabled" : "")">
                <input type="radio"
                       class="visually-hidden"
                       name="resume-template"
                       value="@t.Key"
                       checked="@selected"
                       disabled="@Disabled"
                       @onchange="() => Select(t.Key)" />
                <div class="template-preview" aria-hidden="true">
                    @if (Thumbnails.TryGetValue(t.Key, out var html))
                    {
                        <iframe srcdoc="@WithPageMargins(html)" title="@t.Name sample" tabindex="-1" sandbox=""></iframe>
                    }
                </div>
                <div class="template-info">
                    <div class="template-name">@t.Name</div>
                    <div class="template-desc">@t.Description</div>
                </div>
                @if (selected)
                {
                    <div class="template-check" aria-hidden="true">✓</div>
                }
            </label>
        }
    </div>
</div>

@code {
    #region Constants

    public static readonly TemplateOption[] Templates =
    {
        new(UiConstants.TemplateHarvard, "Harvard", "Classic • ATS-safe"),
        new(UiConstants.TemplateModern, "Modern", "2-column • Color accent"),
        new(UiConstants.TemplateMinimalist, "Minimalist", "Clean • Lots of space"),
        new(UiConstants.TemplateCompact, "Compact", "Dense • Long history"),
        new(UiConstants.TemplateExecutive, "Executive", "Serif • Senior roles")
    };

    // The sample is a full page: these are the PDF margins, so the thumbnail shows the page as it prints
    private const string ThumbnailPageStyle = "<style>body{padding:0.5in 0.75in;}</style>";

    #endregion

    #region Parameters

    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Each template rendered with the sample profile and the chosen style, by template key (UX-10).</summary>
    [Parameter] public IReadOnlyDictionary<string, string> Thumbnails { get; set; } = new Dictionary<string, string>();

    #endregion

    #region Event Handlers

    private async Task Select(string key)
    {
        if (!Disabled) await ValueChanged.InvokeAsync(key);
    }

    #endregion

    #region Helpers

    private static string WithPageMargins(string html)
    {
        var head = html.IndexOf("</head>", StringComparison.OrdinalIgnoreCase);
        return head < 0 ? ThumbnailPageStyle + html : html.Insert(head, ThumbnailPageStyle);
    }

    #endregion
}
