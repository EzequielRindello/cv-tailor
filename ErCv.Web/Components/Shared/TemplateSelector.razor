        </svg>,
        _ => @<svg viewBox="0 0 60 80" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="60" height="80" fill="white" />
            <rect x="8" y="6" width="44" height="4" rx="1" fill="#111" />
            <rect x="12" y="12" width="36" height="2" rx="1" fill="#555" />
            <rect x="8" y="20" width="44" height="1" fill="#111" />
            <rect x="8" y="23" width="20" height="2" rx="1" fill="#444" />
            <rect x="8" y="27" width="40" height="1.5" rx="0.5" fill="#888" />
