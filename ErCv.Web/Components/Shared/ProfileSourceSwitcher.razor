@using static ErCv.Web.Services.CVGeneratorService

@* Step 2: one card per stored profile (the senior sample first), then the visitor's own saved profile *@
<fieldset class="mb-4 profile-source">
    <legend class="form-label form-label-custom">Profile to use</legend>
    <div class="profile-source-options">
        @foreach (var profile in Ordered())
        {
            var id = RadioId(profile.Id);
            var selected = Value == UiConstants.ProfileSourceDemo && ProfileId == profile.Id;
            <div class="profile-source-card @(selected ? "selected" : "") @(Disabled ? "disabled" : "")">
                <input class="visually-hidden" type="radio" name="profile-source" id="@id"
                       checked="@selected" disabled="@Disabled" @onchange="() => PickStored(profile.Id)" />
                <label class="profile-source-label" for="@id">
                    <i class="bi @Icon(profile) profile-source-icon" aria-hidden="true"></i>
                    <span class="profile-source-name">@Label(profile)</span>
                    <span class="profile-source-desc">@Description(profile)</span>
                </label>
            </div>
        }
        @{ var mineSelected = Value == UiConstants.ProfileSourceMine; }
        <div class="profile-source-card @(mineSelected ? "selected" : "") @(HasMine ? "" : "empty") @(Disabled || !HasMine ? "disabled" : "")">
            <input class="visually-hidden" type="radio" name="profile-source" id="source-mine"
                   checked="@mineSelected" disabled="@(Disabled || !HasMine)" @onchange="PickMine" />
            <label class="profile-source-label" for="source-mine">
                <i class="bi bi-person-circle profile-source-icon" aria-hidden="true"></i>
                <span class="profile-source-name">My profile</span>
                <span class="profile-source-desc">@(HasMine ? "Saved in this browser" : "Not created yet. Use Profile at the top.")</span>
            </label>
        </div>
    </div>
</fieldset>

@code {
    #region Constants

    // The creator's profile keeps the id the E2E tests and older bookmarks know
    private const string CreatorRadioId = "source-demo";
    private const string RadioIdPrefix = "source-";

    #endregion

    #region Parameters

    [Parameter] public List<ProfileInfo> Profiles { get; set; } = new();
    [Parameter] public string ProfileId { get; set; } = ApiConstants.SeniorSampleProfileId;
    [Parameter] public EventCallback<string> ProfileIdChanged { get; set; }
    [Parameter] public string Value { get; set; } = UiConstants.ProfileSourceDemo;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool HasMine { get; set; }
    [Parameter] public bool Disabled { get; set; }

    #endregion

    #region Event Handlers

    private async Task PickStored(string id)
    {
        await ProfileIdChanged.InvokeAsync(id);
        await ValueChanged.InvokeAsync(UiConstants.ProfileSourceDemo);
    }

    private Task PickMine() => ValueChanged.InvokeAsync(UiConstants.ProfileSourceMine);

    #endregion

    #region Helpers

    private IEnumerable<ProfileInfo> Ordered() =>
        Profiles.OrderBy(p => p.Id == ApiConstants.SeniorSampleProfileId ? 0 : p.Id == ApiConstants.DefaultProfileId ? 1 : 2)
            .ThenBy(p => p.Id, StringComparer.Ordinal);

    private static string RadioId(string profileId) =>
        profileId == ApiConstants.DefaultProfileId ? CreatorRadioId : RadioIdPrefix + profileId;

    private static string Label(ProfileInfo profile) => profile.Id switch
    {
        ApiConstants.SeniorSampleProfileId => UiConstants.SeniorSampleProfileLabel,
        ApiConstants.DefaultProfileId => UiConstants.CreatorProfileLabel,
        _ => profile.Name
    };

    private static string Description(ProfileInfo profile) => profile.Id switch
    {
        ApiConstants.SeniorSampleProfileId => "Fictional senior engineer",
        ApiConstants.DefaultProfileId => "The app creator's real CV",
        _ => "Stored profile"
    };

    // Same icons as the "Start from" buttons on the profile page
    private static string Icon(ProfileInfo profile) =>
        profile.Id == ApiConstants.SeniorSampleProfileId ? "bi-person-badge" : "bi-person";

    #endregion
}
