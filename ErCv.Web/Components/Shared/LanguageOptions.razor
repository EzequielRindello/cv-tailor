<div class="mb-4">
    <span class="form-label form-label-custom mb-3 d-block" id="language-label">CV language</span>
    <div class="page-options-group" role="radiogroup" aria-labelledby="language-label">
        @foreach (var option in Options)
        {
            var selected = Value == option.Key;
            <label class="page-option-card @(selected ? "selected" : "") @(Disabled ? "disabled" : "")" lang="@option.Key">
                <input type="radio"
                       class="visually-hidden"
                       name="cv-language"
                       value="@option.Key"
                       checked="@selected"
                       disabled="@Disabled"
                       @onchange="() => Select(option.Key)" />
                <div class="page-option-label">@option.Name</div>
                <div class="page-option-desc">@option.Description</div>
            </label>
        }
    </div>
    <p class="style-options-note">Section titles, dates and the summary. The text of your profile stays as you wrote it.</p>
</div>

@code {
    #region Constants

    private static readonly (string Key, string Name, string Description)[] Options =
    {
        (ApiConstants.LanguageEnglish, "English", "Experience, Present"),
        (ApiConstants.LanguageSpanish, "Español", "Experiencia, Actualidad")
    };

    #endregion

    #region Parameters

    [Parameter] public string Value { get; set; } = ApiConstants.LanguageEnglish;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }

    #endregion

    #region Event Handlers

    private async Task Select(string key)
    {
        if (!Disabled) await ValueChanged.InvokeAsync(key);
    }

    #endregion
}
