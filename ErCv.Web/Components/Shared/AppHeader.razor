@inject IJSRuntime JS

<header class="app-topbar" id="app-header">
    <div class="app-topbar-inner">
        <a class="app-wordmark" href="/" aria-label="CV Generator, home">
            <span class="app-wordmark-mark" aria-hidden="true">CV</span>
            <span class="app-wordmark-text">Generator</span>
        </a>
        <nav class="app-topbar-actions" aria-label="Site">
            <a class="app-topbar-link app-try-demo" href="#samples">
                <i class="bi bi-play-circle" aria-hidden="true"></i>
                <span>Try demo</span>
            </a>
            <a class="app-topbar-link"
               href="https://github.com/EzequielRindello/er-cv-generator"
               target="_blank"
               rel="noopener noreferrer">
                <i class="bi bi-github" aria-hidden="true"></i>
                <span>GitHub</span>
            </a>
            <button type="button"
                    class="app-theme-toggle"
                    aria-label="@(_theme == ThemeDark ? "Switch to light theme" : "Switch to dark theme")"
                    title="@(_theme == ThemeDark ? "Switch to light theme" : "Switch to dark theme")"
                    @onclick="ToggleThemeAsync">
                <i class="bi @(_theme == ThemeDark ? "bi-sun" : "bi-moon")" aria-hidden="true"></i>
            </button>
        </nav>
    </div>
</header>

@code {
    #region Constants

    private const string ThemeLight = "light";
    private const string ThemeDark = "dark";

    #endregion

    #region State

    private string _theme = ThemeLight;

    #endregion

    #region Lifecycle

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // The theme is resolved before first paint by the script in App.razor
        _theme = await JS.InvokeAsync<string>(UiConstants.JsGetTheme);
        StateHasChanged();
    }

    #endregion

    #region Event Handlers

    private async Task ToggleThemeAsync()
    {
        _theme = _theme == ThemeDark ? ThemeLight : ThemeDark;
        await JS.InvokeVoidAsync(UiConstants.JsSetTheme, _theme);
    }

    #endregion
}
