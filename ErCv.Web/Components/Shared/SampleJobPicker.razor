@using System.Globalization

@if (Visible)
{
<div class="sample-picker" id="samples" role="group" aria-label="Sample job descriptions">
    <span class="sample-picker-label">Or start from a sample:</span>
    <div class="sample-picker-chips">
        @foreach (var sample in SampleJobDescriptions.All)
        {
            var active = string.Equals(Current, sample.Text, StringComparison.Ordinal);
            <button type="button"
                    class="sample-chip @(active ? "active" : "")"
                    aria-pressed="@(active ? "true" : "false")"
                    disabled="@Disabled"
                    @onclick="() => OnSelect.InvokeAsync(sample.Text)">
                @sample.Label
            </button>
        }
    </div>
    @* The samples are real posts (APP-05): say whose, where and when, and link back to the original *@
    @if (ActiveSample is { } s)
    {
        <p class="sample-picker-source">
            @s.Title at @s.Company@(string.IsNullOrWhiteSpace(s.Location) ? "" : $" ({s.Location})"),
            posted @s.PostedAt.ToString("d MMM yyyy", CultureInfo.InvariantCulture) on @s.Source.
            <a href="@s.Url" target="_blank" rel="noopener noreferrer">View the original post</a>
        </p>
    }
    else
    {
        <p class="sample-picker-source">Each sample is a real, recent post from a public job board.</p>
    }
</div>
}

@code {
    #region Parameters

    [Parameter] public string Current { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public bool Disabled { get; set; }

    #endregion

    #region Helpers

    private SampleJobDescription? ActiveSample =>
        SampleJobDescriptions.All.FirstOrDefault(s => string.Equals(s.Text, Current, StringComparison.Ordinal));

    // Shown while the editor is empty or holds one of the samples (so another can be picked); hidden once the user has their own text
    private bool Visible => string.IsNullOrWhiteSpace(Current) || ActiveSample != null;

    #endregion
}
