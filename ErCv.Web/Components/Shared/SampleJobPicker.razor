@using ErCv.Web.Data

<div class="sample-picker" id="samples" role="group" aria-label="Sample job descriptions">
    <span class="sample-picker-label">No job description at hand? Try a sample:</span>
    <div class="sample-picker-chips">
        @foreach (var sample in SampleJobDescriptions.All)
        {
            var active = string.Equals(Current, sample.Text, StringComparison.Ordinal);
            <button type="button"
                    class="sample-chip @(active ? "active" : "")"
                    aria-pressed="@(active ? "true" : "false")"
                    disabled="@Disabled"
                    @onclick="() => OnSelect.InvokeAsync(sample.Text)">
                @sample.Label
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public string Current { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
