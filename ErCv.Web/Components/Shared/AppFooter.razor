<footer class="app-footer">
    <p>
        No account and no database: your history, settings and profile stay in your own browser.
        <a href="/privacy">Privacy</a>
    </p>
    <p class="app-footer-version">v@(Version)</p>
</footer>

@code {
    private static readonly string Version =
        (typeof(AppFooter).Assembly.GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false)
            .Cast<System.Reflection.AssemblyInformationalVersionAttribute>()
            .FirstOrDefault()?.InformationalVersion ?? "1.0.0")
        .Split('+')[0];
}
