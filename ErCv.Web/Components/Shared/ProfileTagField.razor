@* Comma-separated list (skills, courses, technologies) edited as one text field *@
<ProfileField Id="@Id" Label="@Label" Placeholder="Comma separated"
              Value="@string.Join(", ", Values)" Error="Error" CssClass="@CssClass"
              ValueChanged="OnChange" />

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public List<string> Values { get; set; } = new();
    [Parameter] public string? Error { get; set; }
    [Parameter] public string? CssClass { get; set; }

    private void OnChange(string text)
    {
        Values.Clear();
        Values.AddRange(text.Split(',').Select(t => t.Trim()).Where(t => t.Length > 0));
    }
}
