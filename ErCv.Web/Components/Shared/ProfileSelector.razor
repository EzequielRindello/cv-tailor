@using static ErCv.Web.Services.CVGeneratorService

@if (Profiles.Count > 1)
{
    <div class="mb-4">
        <label class="form-label form-label-custom">CV Profile</label>
        <select class="form-select profile-selector"
                disabled="@Disabled"
                @onchange="e => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)">
            @foreach (var profile in Profiles)
            {
                <option value="@profile.Id" selected="@(profile.Id == Value)">@profile.Name</option>
            }
        </select>
    </div>
}

@code {
    [Parameter] public List<ProfileInfo> Profiles { get; set; } = new();
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
}
