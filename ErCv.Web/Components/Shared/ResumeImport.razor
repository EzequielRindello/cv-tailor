@inject ToastService Toasts

<span class="resume-import">
    <label class="btn btn-outline-secondary btn-sm mb-0 @(_reading ? "disabled" : "")" id="profile-use-resume">
        <i class="bi bi-file-earmark-text" aria-hidden="true"></i> @(_reading ? "Reading your resume..." : "My resume (PDF or Word)")
        <InputFile id="profile-import-resume" class="visually-hidden" accept="@ResumeImportConstants.Accept" disabled="@_reading"
                   aria-describedby="resume-import-limits" OnChange="ImportAsync" />
    </label>
    <button type="button" class="resume-import-info" id="resume-import-info" aria-label="What can be read from a resume"
            aria-describedby="resume-import-limits" aria-expanded="@(_showLimits ? "true" : "false")"
            @onclick="ToggleLimits" @onkeydown="CloseOnEscape" @onfocus="ShowAgain" @onmouseenter="ShowAgain">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
    </button>
    <div role="tooltip" id="resume-import-limits" class="resume-import-limits @(_showLimits ? "show" : "") @(_dismissed ? "dismissed" : "")">
        <ul>
            @foreach (var line in ResumeImportConstants.LimitLines)
            {
                <li>@line</li>
            }
        </ul>
    </div>
</span>

@code {
    #region Constants

    private const string Unreadable = "The file could not be read.";

    #endregion

    #region Parameters

    /// <summary>The draft read from the resume (PROF-05); the page loads it in the editor for review.</summary>
    [Parameter] public EventCallback<CVMaster> OnImport { get; set; }

    #endregion

    #region State

    private bool _reading;
    private bool _showLimits;
    private bool _dismissed;

    #endregion

    #region Event Handlers

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        // The wrong type or a file over the limit is refused by its name and size, before any byte is read
        if (ResumeImporter.UploadError(e.File.Name, e.File.Size) is { } refused)
        {
            Toasts.Error(refused);
            return;
        }

        _reading = true;
        try
        {
            byte[] bytes;
            try
            {
                await using var stream = e.File.OpenReadStream(ResumeImportConstants.MaxImportBytes);
                using var memory = new MemoryStream();
                await stream.CopyToAsync(memory);
                bytes = memory.ToArray();
            }
            catch (IOException)
            {
                Toasts.Error(Unreadable);
                return;
            }

            var result = await ResumeImporter.ImportAsync(bytes);
            if (result.Profile == null)
            {
                Toasts.Error(result.Error ?? Unreadable);
                return;
            }
            await OnImport.InvokeAsync(result.Profile);
        }
        finally
        {
            _reading = false;
        }
    }

    private void ToggleLimits()
    {
        _dismissed = false;
        _showLimits = !_showLimits;
    }

    // Escape hides the tooltip even while the pointer or the focus is still on the button (WCAG 1.4.13)
    private void ShowAgain() => _dismissed = false;

    private void CloseOnEscape(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        _showLimits = false;
        _dismissed = true;
    }

    #endregion
}
