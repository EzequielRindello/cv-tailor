@using System.Text.Json

@if (_localCv != null)
{
    var totalSelected = _selections.Values.Sum(a => a.Count(b => b));
    var totalBullets = _selections.Values.Sum(a => a.Count);

    <div class="card bullet-editor-card">
        <div class="card-body">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--spacing-md)">
                <div>
                    <h5 class="bullet-editor-title">
                        <i class="bi bi-pencil-square bullet-title-icon"></i>
                        Edit Bullets
                    </h5>
                    <div class="bullet-editor-subtitle">
                        @totalSelected/@totalBullets selected · Uncheck to exclude · Drag
                        <i class="bi bi-grip-vertical bullet-drag-icon"></i>
                        to reorder
                    </div>
                </div>
            </div>

            @for (var expIdx = 0; expIdx < _localCv.Experience.Count; expIdx++)
            {
                var ei = expIdx;
                var exp = _localCv.Experience[ei];
                var expKey = "exp" + ei;
                var expSelections = _selections[expKey];
                var selectedCount = expSelections.Count(b => b);

                <div class="bullet-exp-block" @key="expKey">
                    <div class="bullet-exp-header">
                        <div class="bullet-exp-role">@exp.Role</div>
                        <div class="exp-company-label">@exp.Company · @exp.StartDate – @exp.EndDate</div>
                    </div>

                    <div class="bullets-list">
                        @for (var bulletIdx = 0; bulletIdx < exp.Bullets.Count; bulletIdx++)
                        {
                            var bi = bulletIdx;
                            var isSelected = expSelections[bi];
                            var canDeselect = selectedCount > 1;
                            var dragging = _dragExp == ei && _dragIdx == bi;

                            var rowClass = "bullet-row" + (!isSelected ? " deselected" : "") + (dragging ? " dragging" : "");

                            <div class="@rowClass"
                                 draggable="true"
                                 @ondragstart="() => DragStart(ei, bi)"
                                 @ondragover="() => DragOver(ei, bi)"
                                 @ondragover:preventDefault
                                 @ondragend="DragEnd">
                                <span class="drag-handle">⠿</span>
                                <input type="checkbox"
                                       class="bullet-checkbox"
                                       checked="@isSelected"
                                       disabled="@(isSelected && !canDeselect)"
                                       title="@(isSelected && !canDeselect ? "At least 1 bullet must remain" : "")"
                                       @onchange="() => Toggle(ei, bi)" />
                                <span class="bullet-text">@exp.Bullets[bi]</span>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="bullet-editor-actions">
                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@Loading" @onclick="OnCancel">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm" disabled="@Loading" @onclick="Regenerate">
                    @(Loading ? "Regenerating..." : $"Regenerate CV ({totalSelected} bullets)")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public GeneratedCV? GeneratedCv { get; set; }
    [Parameter] public EventCallback<(Dictionary<string, List<int>> Selections, GeneratedCV Cv)> OnRegenerate { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public bool Loading { get; set; }

    private GeneratedCV? _localCv;
    private GeneratedCV? _sourceCv;
    private Dictionary<string, List<bool>> _selections = new();
    private int _dragExp = -1;
    private int _dragIdx = -1;

    protected override void OnParametersSet()
    {
        if (GeneratedCv == null || ReferenceEquals(GeneratedCv, _sourceCv)) return;

        _sourceCv = GeneratedCv;
        _localCv = JsonSerializer.Deserialize<GeneratedCV>(JsonSerializer.Serialize(GeneratedCv));
        _selections = new();

        for (var i = 0; i < _localCv!.Experience.Count; i++)
            _selections["exp" + i] = Enumerable.Repeat(true, _localCv.Experience[i].Bullets.Count).ToList();
    }

    private void Toggle(int expIdx, int bulletIdx)
    {
        var arr = _selections["exp" + expIdx];
        if (arr[bulletIdx] && arr.Count(b => b) <= 1) return;
        arr[bulletIdx] = !arr[bulletIdx];
    }

    private void DragStart(int expIdx, int bulletIdx)
    {
        _dragExp = expIdx;
        _dragIdx = bulletIdx;
    }

    private void DragOver(int expIdx, int bulletIdx)
    {
        if (_dragExp != expIdx || _dragIdx < 0 || _dragIdx == bulletIdx) return;

        Move(_localCv!.Experience[expIdx].Bullets, _dragIdx, bulletIdx);
        Move(_selections["exp" + expIdx], _dragIdx, bulletIdx);
        _dragIdx = bulletIdx;
    }

    private void DragEnd()
    {
        _dragExp = -1;
        _dragIdx = -1;
    }

    private static void Move<T>(List<T> list, int from, int to)
    {
        var item = list[from];
        list.RemoveAt(from);
        list.Insert(to, item);
    }

    private Task Regenerate()
    {
        var bulletSelections = _selections.ToDictionary(
            kv => kv.Key,
            kv => kv.Value.Select((selected, i) => selected ? i : -1).Where(i => i >= 0).ToList());

        return OnRegenerate.InvokeAsync((bulletSelections, _localCv!));
    }
}
