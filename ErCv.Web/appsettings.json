{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000",
  "ErCv": {
    "RateLimit": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "ImportRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Session": {
      "IdleTimeoutMinutes": 10
    }
  }
}
