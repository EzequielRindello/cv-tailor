<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ErCv.Web</RootNamespace>
		<!-- One version per milestone, see "Versioning" in features.md. Shown in the app footer. -->
		<Version>2.0.4</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
		<PackageReference Include="PuppeteerSharp" Version="19.0.0" />
		<PackageReference Include="Stubble.Core" Version="1.10.8" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- APP-03 samples, written by the corpus collector (APP-05). Embedded so the app does not depend on the corpus folder. -->
		<None Remove="Data\sample-jobs.json" />
		<EmbeddedResource Include="Data\sample-jobs.json" LogicalName="ErCv.Web.Data.sample-jobs.json" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Data\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Templates\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>