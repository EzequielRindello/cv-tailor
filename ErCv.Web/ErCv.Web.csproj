<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ErCv.Web</RootNamespace>
		<!-- One version per milestone, see "Versioning" in features.md. Shown in the app footer. -->
		<Version>2.0.6</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
		<!-- PROF-05: reads the text of an uploaded resume PDF -->
		<PackageReference Include="PdfPig" Version="0.1.16" />
		<PackageReference Include="PuppeteerSharp" Version="25.15.0" />
		<PackageReference Include="Scalar.AspNetCore" Version="2.18.2" />
		<PackageReference Include="Stubble.Core" Version="1.10.8" />
	</ItemGroup>

	<ItemGroup>
		<!-- APP-03 samples, written by the corpus collector (APP-05). Embedded so the app does not depend on the corpus folder. -->
		<None Remove="Data\sample-jobs.json" />
		<EmbeddedResource Include="Data\sample-jobs.json" LogicalName="ErCv.Web.Data.sample-jobs.json" />
		<!-- MATCH-07 skill dictionary, embedded for the same reason and read once at startup -->
		<None Remove="Data\skills.json" />
		<EmbeddedResource Include="Data\skills.json" LogicalName="ErCv.Web.Data.skills.json" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Data\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Templates\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>