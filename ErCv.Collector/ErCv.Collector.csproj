<Project Sdk="Microsoft.NET.Sdk">

	<!-- APP-05: console tool that keeps the job-post corpus in corpus/ fresh. Not part of the web app or its image. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ErCv.Collector</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<!-- The relevance report and the sample picker use the app's own parser and skill dictionary -->
		<ProjectReference Include="..\ErCv.Web\ErCv.Web.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ErCv.Tests" />
	</ItemGroup>

</Project>
